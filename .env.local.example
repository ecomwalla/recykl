# Copy this file to ".env.local" and fill in the real values below.
# ".env.local" is never committed to git — it's for secrets only.
#
# All three values come from: your Supabase project dashboard
# -> Settings (gear icon, bottom left) -> API

# The web address of your Supabase project. Safe to expose publicly —
# it's just an address, not a secret.
# Find it under: Settings -> API -> "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# A public key that lets this website talk to Supabase on behalf of a
# visitor. Safe to expose publicly — access is restricted by rules
# ("Row Level Security" policies) you set up in Supabase later.
# Find it under: Settings -> API -> "Project API keys" -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A master key with FULL admin access to your database, bypassing every
# safety rule. Keep this secret — it's only ever used in server-side code,
# never sent to a visitor's browser. Do not share it, do not paste it into
# chat messages, do not commit it to git.
# Find it under: Settings -> API -> "Project API keys" -> service_role / secret
SUPABASE_SERVICE_ROLE_KEY=
